#!/bin/sh
# metel-core#1268: heavier local check, once per push rather than per commit.
# rfc.py check already degrades gracefully (an informational skip, not a
# failure) when metel-interpreter/tests isn't reachable -- see ADR-0049 §6 --
# so this needs no special-casing for a bare docs-only checkout.
#
# See pre-commit's comment: git sets GIT_DIR/etc. for hook invocations, and
# it leaks into anything spawned here. Unset defensively.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES

set -e

echo "pre-push: rfc.py check"
python3 rfcs/tools/rfc.py check
